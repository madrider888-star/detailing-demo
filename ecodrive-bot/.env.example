# ─────────────────────────────────────────────────────────────
# EcoDrive Auto bot — пример настроек. Скопируйте в .env и заполните.
# Реальные секреты НЕ коммитьте: .env исключён из git.
# ─────────────────────────────────────────────────────────────

# Окружение: dev | prod
APP_ENV=dev
LOG_LEVEL=INFO
# json — для сервера, console — для локальной отладки
LOG_FORMAT=json

# ── Telegram ─────────────────────────────────────────────────
# Токен из @BotFather
BOT_TOKEN=
# Администраторы (всегда имеют доступ и роль admin), через запятую
ADMIN_TELEGRAM_IDS=
# Белый список сотрудников (получают роль employee при первом входе)
ALLOWED_TELEGRAM_IDS=

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=ecodrive
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecodrive
DATABASE_URL=postgresql+asyncpg://ecodrive:change-me@postgres:5432/ecodrive

# ── Redis (FSM + очередь ARQ) ────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Объектное хранилище (S3: SeaweedFS в compose или внешний S3) ──
# s3 | local
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=ecodrive-media
S3_ACCESS_KEY=ecodrive
S3_SECRET_KEY=change-me-s3-secret
# Для локального бэкенда:
LOCAL_STORAGE_PATH=/data/storage

# ── Провайдеры обработки ─────────────────────────────────────
# Фон / диски / салон: mock | openai
IMAGE_PROVIDER=mock
# Номерные таблички: opencv (локально, бесплатно) | openai (рисует OpenAI по маске) | mock
PLATE_PROVIDER=opencv

# OpenAI-совместимый API редактирования изображений (images/edits)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
# high — максимально сохранять детали исходника (если модель поддерживает)
OPENAI_INPUT_FIDELITY=high

PROVIDER_TIMEOUT_SECONDS=180
PROVIDER_MAX_RETRIES=3

# ── Номерные таблички ────────────────────────────────────────
BRANDED_PLATE_PATH=assets/branded_plate/ecodrive_plate.png
PLATE_CONFIDENCE_THRESHOLD=0.55
# Высота фирменной таблички относительно высоты номера (1.0 — как номер, 1.4 — чуть выше)
PLATE_TEMPLATE_HEIGHT_RATIO=1.5
# Необязательная ONNX-модель YOLO для детекции номеров (single-class)
PLATE_DETECTOR_MODEL_PATH=

# ── Лимиты ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=60000000
MIN_IMAGE_SIDE=320
MAX_ACTIVE_JOBS_PER_USER=2

# ── Экспорт (подготовка для AutoRIA) ─────────────────────────
EXPORT_MAX_SIDE=2560
EXPORT_JPEG_QUALITY=92
EXPORT_MIN_JPEG_QUALITY=90
EXPORT_MAX_BYTES=8388608
VISUALIZATION_LABEL_ENABLED=true
VISUALIZATION_LABEL_TEXT=Візуалізація
VISUALIZATION_LABEL_OPERATIONS=background,wheels,interior_color
FONT_PATH=assets/fonts/DejaVuSans.ttf

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
