# Скопировать в .env и заполнить. Файл .env в git не попадает.

APP_ENV=prod
LOG_LEVEL=INFO
LOG_FORMAT=json

# Персона консультанта
BOT_NAME=Олена
SHOP_NAME=ECODRIVE AUTO
SHOP_SITE=https://ecodrive.in.ua

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low

# KeyCRM (Настройки → Интеграции → API)
KEYCRM_API_KEY=
KEYCRM_PIPELINE_ID=
KEYCRM_SOURCE_ID=

# Нова Пошта — ключ из бизнес-кабинета (не обязателен для отслеживания)
NOVAPOSHTA_API_KEY=

# Каталог CS-Cart (Администрирование → Пользователи → API-ключ); без ключа — разбор поиска сайта
CSCART_BASE_URL=https://ecodrive.in.ua
CSCART_API_EMAIL=
CSCART_API_KEY=

# Telegram: отдельный бот от @BotFather и id группы менеджеров (отрицательное число)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGERS_CHAT_ID=

# Веб
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=https://ecodrive.in.ua,https://www.ecodrive.in.ua
RATE_LIMIT_PER_MINUTE=20
